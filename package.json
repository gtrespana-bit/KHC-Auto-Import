{
  "name": "khc-auto-import",
  "private": true,
  "version": "1.0.0",
  "description": "KHC Auto Import · Web pública (Next.js) y ERP de gestión (Vite) en un solo proyecto y un solo despliegue",
  "type": "module",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "dev:erp": "vite --config erp/vite.config.js",
    "build": "npm run build:erp && npm run build:web",
    "build:erp": "vite build --config erp/vite.config.js",
    "build:web": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview:erp": "vite preview --config erp/vite.config.js",
    "check": "node scripts/check-domain.mjs && node scripts/check-prices.mjs && node scripts/check-inspection.mjs",
    "catalog:stats": "node scripts/catalog-stats.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:trip": "node scripts/test-trip-vehicle.mjs && node scripts/test-trip-map.mjs",
    "test:vat": "node scripts/test-vat-purchase-semantics.mjs",
    "test:demo": "node scripts/test-demo-data.mjs",
    "test:publication": "node scripts/test-web-publication.mjs",
    "prices:check": "node scripts/check-prices.mjs",
    "scrape:de": "node scripts/autoscout-de-scrape.mjs --import"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/analytics": "^2.0.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
