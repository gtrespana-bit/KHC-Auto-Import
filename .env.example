# ============================================================================
#  VARIABLES DE ENTORNO — copia este fichero como `.env.local` en desarrollo
#  y define las mismas en Vercel (Settings → Environment Variables) para
#  Production, Preview y Development.
#
#  Hay dos bloques porque el proyecto sirve dos aplicaciones:
#    · NEXT_PUBLIC_*  → web pública (Next.js, khcimport.autos)
#    · VITE_*         → ERP (Vite, app.khcimport.autos) y el cron de Supabase
#
#  En los dos casos es la clave `anon public`: la seguridad la imponen las
#  políticas RLS de la base de datos. Nunca la clave `service_role`.
# ============================================================================

# --- Base de datos (una sola para las dos aplicaciones) ---------------------
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# --- Web pública ------------------------------------------------------------
# Sin las dos claves de Supabase la web arranca en MODO DEMOSTRACIÓN (datos de
# ejemplo, no indexable). Eso permite trabajar en el diseño sin tocar datos.
# URL pública del sitio (canónicas, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://khcimport.autos

# --- Enrutado por dominio (opcional) ----------------------------------------
# Dominio(s) del ERP. Por defecto app.khcimport.autos y cualquier `app.*`.
ERP_HOST=app.khcimport.autos

# --- Mapa de la calculadora de viaje (opcional) -----------------------------
# Servidor de teselas propio para el mapa del ERP. Si se deja vacío (lo normal)
# se usan servidores comunitarios de OpenStreetMap, que no piden ninguna clave.
# Defínela solo si contratas un proveedor con SLA o clave (MapTiler,
# Thunderforest, CARTO con clave…). Es lo recomendable en cuanto el consumo
# deje de ser anecdótico: los servidores comunitarios son para uso moderado y
# algunos (los voluntarios de la OSMF) bloquean directamente las apps de
# empresa. Debe ser una plantilla con {z}/{x}/{y}:
# VITE_TRIP_MAP_TILE_URL=https://api.maptiler.com/maps/streets/{z}/{x}/{y}.png?key=TU_CLAVE
VITE_TRIP_MAP_TILE_URL=

# --- Avisos y buscadores (opcional) -----------------------------------------
# Webhook al que se reenvía cada contacto recibido (Telegram, Slack, Make,
# n8n…). Si no se define, el contacto queda solo en la base de datos.
LEAD_WEBHOOK_URL=

# Verificación de propiedades en Google Search Console y Bing Webmaster.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
