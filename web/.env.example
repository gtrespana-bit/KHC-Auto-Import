# Web pública (Next.js). Copia este fichero como .env.local en desarrollo y
# define las mismas variables en el proyecto de Vercel de la web.
#
# Sin estas dos variables la web arranca en MODO DEMOSTRACIÓN (datos de
# ejemplo, no indexable en Google). Eso permite trabajar en el diseño sin
# tocar la base de datos real.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# URL pública del sitio (canónicas, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://khcimport.autos

# Opcional: webhook al que se reenvía cada contacto recibido (Telegram, Slack,
# Make, n8n…). Si no se define, el contacto queda solo en la base de datos.
LEAD_WEBHOOK_URL=
